APP_NAME=User_MS
APP_ENV=local
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/users_db

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:4200

# External integrations (empty allowlist disables new provider connections).
EXTERNAL_API_ALLOWED_HOSTS=
# Inject a Fernet key from protected environment/secret manager; never commit a real key.
INTEGRATIONS_ENCRYPTION_KEY=
SERVICE_TOKEN=
ASSESMENT_MS_URL=http://localhost:8002

# During key rotation only; inject previous keys externally, separated by commas.
INTEGRATIONS_PREVIOUS_KEYS=
