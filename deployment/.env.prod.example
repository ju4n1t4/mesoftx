# Copie a .env.prod (NO lo suba a Git; está en .gitignore) y reemplace TODOS los valores.
# Los secretos deben ser aleatorios y de >= 32 caracteres; la API no arranca en producción
# con valores de ejemplo. Generar:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
SERVICE_TOKEN=
# Contraseña de PostgreSQL: use solo letras, números, '-' y '_' (va dentro de una URL).
POSTGRES_PASSWORD=
POSTGRES_USER=mesoftx
# Origen público EXACTO desde el que se sirve el sitio (CORS), con https y sin barra final.
PUBLIC_ORIGIN=https://mesoftx.example.edu.co
FRONTEND_PORT=8083
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
