USER_MS_PORT=8001
USER_MS_DATABASE_URL=postgresql+psycopg2://postgres:postgres@mesoftx-db:5432/users_db
USER_MS_JWT_SECRET_KEY=
USER_MS_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
USER_MS_CORS_ORIGINS=http://localhost:4200

ASSESMENT_MS_PORT=8002
ASSESMENT_MS_DATABASE_URL=postgresql+psycopg2://postgres:postgres@mesoftx-db:5432/assesment_mesoftx_db
ASSESMENT_MS_CORS_ORIGINS=http://localhost:4200
# URLs de comunicación entre microservicios (paso 12).
USER_MS_URL=http://user-ms:8001
ASSESMENT_MS_URL=http://assesment-ms:8002
# Secreto compartido. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SERVICE_TOKEN=

# External integrations (empty allowlist disables new provider connections).
EXTERNAL_API_ALLOWED_HOSTS=
# Inject a Fernet key from protected environment/secret manager; never commit a real key.
INTEGRATIONS_ENCRYPTION_KEY=

# During key rotation only; inject previous keys externally, separated by commas.
INTEGRATIONS_PREVIOUS_KEYS=
